# Backend environment example

# Primary database: MySQL
# Example: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/wd_computer"

# Optional fallback database: SQLite (used only if you explicitly configure it in code)
# Example local file:
FALLBACK_DATABASE_URL="file:./wd_computer_fallback.db"

PORT=4000
JWT_SECRET="change-me"